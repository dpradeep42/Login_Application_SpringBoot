# Copy these into your shell, or into a local .env file that is not committed.
# The app reads them as environment variables. It does not load a .env file by itself.
#
# DB_URL is optional. When it is unset, the app uses
# jdbc:sqlserver://localhost:1433;databaseName=Credentials

DB_URL=jdbc:sqlserver://localhost:1433;databaseName=Credentials
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
